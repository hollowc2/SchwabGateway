SCHWAB_GATEWAY_TOKEN_DIR=/absolute/path/to/token-directory
SCHWAB_GATEWAY_KEYS_PATH=/absolute/path/to/digest-only-keys.json
SCHWAB_GATEWAY_UID=1001
SCHWAB_GATEWAY_GID=1001
SCHWAB_GATEWAY_OPTION_CHAIN_CACHE_TTL_SECONDS=3
SCHWAB_GATEWAY_OPTION_CHAIN_CACHE_MAX_ENTRIES=16
SCHWAB_GATEWAY_OPTION_CHAIN_MAX_INFLIGHT=4
# Set SCHWAB_API_KEY and SCHWAB_SECRET_KEY only in the protected runtime environment.
