[Unit]
Description=Capture host and container DNS evidence for SchwabGateway

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/schwab-gateway-dns-monitor/probe_dns.py --container schwab_gateway_live --container turtlequant-bot --timeout-seconds 3
TimeoutStartSec=25s
NoNewPrivileges=true
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=schwab-gateway-dns-probe
